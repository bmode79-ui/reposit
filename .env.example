# Kakao Developers app REST API key (used to refresh the access token).
# https://developers.kakao.com > My Application > App Keys > REST API key
KAKAO_REST_API_KEY=

# OAuth refresh token obtained after user consent (recommended).
# When set, the server auto-refreshes the access token as needed.
KAKAO_REFRESH_TOKEN=

# Optional: a directly-supplied access token. If provided it is used as-is
# until it expires; with a refresh token the server will renew it automatically.
KAKAO_ACCESS_TOKEN=

# Optional overrides (mostly for local testing / mocking). Defaults shown.
# KAKAO_API_BASE_URL=https://kapi.kakao.com
# KAKAO_AUTH_BASE_URL=https://kauth.kakao.com
